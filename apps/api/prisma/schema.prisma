// Primary relational store (PRD 4: PostgreSQL on the VPS).
// Live/ephemeral state (queue position churn, leaderboards, session presence)
// lives in Redis, not here — see apps/api/src/config/redis.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  VENUE_STAFF
  VENUE_ADMIN
  SUPER_ADMIN
}

enum QueueEntryStatus {
  PENDING
  PLAYING
  COMPLETED
  SKIPPED
}

enum RewardTier {
  BRONZE
  SILVER
  GOLD
}

enum PerformanceMode {
  SOLO
  DUO
  BATTLE
}

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?
  displayName  String?
  role         Role     @default(PATRON)
  venueId      String? // null for PATRON / SUPER_ADMIN
  venue        Venue?   @relation(fields: [venueId], references: [id])
  createdAt    DateTime @default(now())

  queueEntries      QueueEntry[]
  scores            Score[]
  rewardRedemptions RewardRedemption[]
  attendances       Attendance[]
  votesCast         PerformanceVote[]

  @@index([venueId])
}

model Venue {
  id                 String   @id @default(cuid())
  name                String
  slug                String   @unique
  posProvider         String? // e.g. "loyverse"
  posApiKeyEncrypted  String?
  goldThreshold        Int      @default(90)
  silverThreshold      Int      @default(75)
  bronzeThreshold      Int      @default(60)
  goldDiscountPercent  Int      @default(30)
  silverDiscountPercent Int     @default(20)
  bronzeDiscountPercent Int     @default(10)
  createdAt           DateTime @default(now())

  tables Table[]
  users  User[]
  songs  QueueEntry[]

  @@index([slug])
}

model Table {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  label     String // e.g. "Table 12"
  pin       String // short PIN alternative to QR
  qrToken   String   @unique
  createdAt DateTime @default(now())

  queueEntries QueueEntry[]
  attendances  Attendance[]

  @@unique([venueId, label])
  @@index([venueId])
}

model QueueEntry {
  id             String            @id @default(cuid())
  venueId        String
  venue          Venue             @relation(fields: [venueId], references: [id])
  tableId        String
  table          Table             @relation(fields: [tableId], references: [id])
  requestedById  String
  requestedBy    User              @relation(fields: [requestedById], references: [id])
  youtubeVideoId String
  title          String
  status         QueueEntryStatus  @default(PENDING)
  mode           PerformanceMode   @default(SOLO)
  position       Int
  createdAt      DateTime          @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  // 3.4 Peer voting — set when the song ends; votes are accepted until then,
  // after which the tally is frozen into a Score. Persisted (not Redis) so a
  // restart can still close windows it missed.
  votingClosesAt DateTime?

  score Score?
  votes PerformanceVote[]

  @@index([venueId, status])
  @@index([tableId])
}

model Score {
  id            String     @id @default(cuid())
  queueEntryId  String     @unique
  queueEntry    QueueEntry @relation(fields: [queueEntryId], references: [id])
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  value         Int // 0-100, derived from the vote average (see shared/voting.ts)
  voteCount     Int         @default(0)
  averageVote   Float? // raw 1-5 mean, for display
  pitchAccuracy Float? // deprecated: DSP scoring is parked, never written
  streakBonus   Float? // deprecated: DSP scoring is parked, never written
  tier          RewardTier?
  createdAt     DateTime   @default(now())

  rewardRedemption RewardRedemption?

  @@index([userId])
}

// 3.4 Peer voting — one ballot per patron per performance. The performer's
// own vote is refused at the API; the unique index makes double-voting
// impossible even under concurrent taps.
model PerformanceVote {
  id           String     @id @default(cuid())
  queueEntryId String
  queueEntry   QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  voterId      String
  voter        User       @relation(fields: [voterId], references: [id])
  value        Int // 1-5
  createdAt    DateTime   @default(now())

  @@unique([queueEntryId, voterId])
  @@index([queueEntryId])
  @@index([voterId])
}

model RewardRedemption {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  scoreId         String?    @unique
  score           Score?     @relation(fields: [scoreId], references: [id])
  tier            RewardTier
  discountPercent Int
  qrCode          String     @unique
  redeemedAt      DateTime?
  posDiscountId   String? // Loyverse (or other POS) discount id staff apply at checkout
  createdAt       DateTime   @default(now())

  @@index([userId])
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id])
  visitDate DateTime @default(now())

  @@index([userId])
  @@index([tableId])
}
