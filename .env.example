# Shared across services when running via infra/docker-compose.yml

DATABASE_URL=postgresql://karaoke:karaoke@localhost:5432/karaoke
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
INTERNAL_SERVICE_SECRET=change-me-too
APP_ENCRYPTION_KEY=change-me-too-32-bytes-min-entropy

PORT=4000
CORS_ORIGIN=http://localhost:5173

# 3.1 YouTube Data API v3 key (Search API enabled) — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=028535bb8emshe6bccc3ddc88792p12fed3jsn3473c6dc6798

# Google Sign-In (mobile patron auth) — a "Web application" OAuth client from
# https://console.cloud.google.com/apis/credentials. Add the redirect URI the
# app logs on first run (via expo-auth-session) to its Authorized redirect URIs.
# GOOGLE_CLIENT_ID must also be set in apps/mobile/src/lib/config.ts (it's
# public, safe in client code); GOOGLE_CLIENT_SECRET stays server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DSP service
API_BASE_URL=http://localhost:4000
DSP_SAMPLE_RATE=44100

# POS integration (3.5) — venues connect their own Loyverse token via
# POST /venues/:id/pos/connect; this var is only for local/manual testing.
LOYVERSE_API_KEY=
