# Shared across services when running via infra/docker-compose.yml

DATABASE_URL=postgresql://karaoke:karaoke@localhost:5432/karaoke
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
INTERNAL_SERVICE_SECRET=change-me-too

PORT=4000
CORS_ORIGIN=http://localhost:5173

# DSP service
API_BASE_URL=http://localhost:4000
DSP_SAMPLE_RATE=44100

# POS integration (per-venue overrides stored in the Venue table; these are
