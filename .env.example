# Google Sign-In (mobile patron auth) — a "Web application" OAuth client from
# https://console.cloud.google.com/apis/credentials. Add the redirect URI the
# app logs on first run (via expo-auth-session) to its Authorized redirect URIs.
# GOOGLE_CLIENT_ID must also be set in apps/mobile/src/lib/config.ts (it's
# public, safe in client code); GOOGLE_CLIENT_SECRET stays server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# POS integration (3.5) — venues connect their own Loyverse token via
# POST /venues/:id/pos/connect; this var is only for local/manual testing.
LOYVERSE_API_KEY=
